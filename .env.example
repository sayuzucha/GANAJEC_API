DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=ganajec_db

SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ── SMTP (envio de correos: verificacion, recuperacion) ─────────────────
# Usa una "App Password" de Google si usas Gmail con 2FA activado.
# SMTP_PORT=465 para SSL, 587 para TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM=tu_correo@gmail.com

# ── Firebase Cloud Messaging (notificaciones push) ──────────────────────
# 1. Ve a Firebase Console → tu proyecto → Configuración → Cuentas de servicio
# 2. Clic en "Generar nueva clave privada" → descarga el JSON
# 3. Convierte todo el JSON a una sola línea y pégalo aquí
# Ejemplo: FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"ganajec-ai",...}
FIREBASE_CREDENTIALS_JSON=

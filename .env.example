# ══════════════════════════════════════════════════════════════════════
# GANAJEC AI — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a git.
# ══════════════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────────────
# OPCIÓN A: URL completa (Aiven — copia el "Service URI" del dashboard)
# DATABASE_URL=mysql://avnadmin:PASS@host.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# OPCIÓN B: partes separadas (desarrollo local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=ganajec_db

# Fuerza SSL aunque no sea Aiven (opcional)
# DB_SSL=true

# ── Seguridad JWT ──────────────────────────────────────────────────────
# Genera una clave aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ── SMTP (envío de correos: verificación, recuperación) ───────────────
# Usa una "App Password" de Google si usas Gmail con 2FA activado.
# SMTP_PORT=465 para SSL, 587 para TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM=tu_correo@gmail.com

# ── Firebase Cloud Messaging (notificaciones push) ────────────────────
# 1. Firebase Console → tu proyecto → Configuración → Cuentas de servicio
# 2. "Generar nueva clave privada" → descarga el JSON
# 3. Convierte el JSON a una sola línea y pégalo aquí
FIREBASE_CREDENTIALS_JSON=

# ── Stripe (pagos) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
